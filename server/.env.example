DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=your-sql-server-password
DB_NAME=TuneGENDB
PORT=3001
ADMIN_PASSWORD=your-secure-admin-password

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Google sign-in (optional). Must equal VITE_GOOGLE_CLIENT_ID; without it the server refuses Google sign-in.
GOOGLE_CLIENT_ID=
# Automated database backups are configured in the app (Settings > Backups, platform administrators only). These variables are only the
# starting values until the console saves its own: BACKUP_JOB=on seeds the master switch (migration 0006); BACKUP_DIR is a folder on the SQL
# Server host; OFFSITE_BACKUP_DIR is a UNC share on ANOTHER machine (required for a real recovery plan). BACKUP_SCHEDULER=off stops this
# process from scheduling anything (a second instance, a test server).
BACKUP_JOB=off
BACKUP_DIR=
OFFSITE_BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULER=
JWT_SECRET=your-64-char-hex-secret-here

# AI reporting (optional)
AI_PROVIDER=mock
# REPORT_DB_USER=report_reader
# REPORT_DB_PASSWORD=

# Catalogue scraper. TEST SERVERS ONLY: CATALOGUE_ALLOW_LOOPBACK=on lets it scrape 127.0.0.1 (a fixture shop). Never set it in production.
CATALOGUE_ALLOW_LOOPBACK=
CATALOGUE_MIN_GAP_MS=
